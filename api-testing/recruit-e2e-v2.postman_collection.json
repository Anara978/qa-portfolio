          "raw": "{\n  \"firstName\": \"Migen\",\n  \"middleName\": \"\",\n  \"lastName\": \"Kim\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{candidatePassword}}\",\n  \"address\": \"2019 Broklyn\",\n  \"city\": \"NY\",\n  \"state\": \"NY\",\n  \"zip\": \"20381\",\n  \"summary\": \"QA student with interest in automation testing\"\n}",
