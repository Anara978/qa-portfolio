    {
      "name": "candidate login",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var candidateToken =\npm.response.json().token;\npm.environment.set(\"candidateToken\",candidateToken);\n\npm.test(\"Status code is 200\", function () {\n    pm.response.to.have.status(200);\n});\n\npm.test(\"authenticated is true\", function () {\n    var jsonData = pm.response.json();\n    pm.expect(jsonData.authenticated).to.be.true;\n});\n\npm.test(\"Response schema is valid\", function () {\n    const schema = {\n        type: \"object\",\n        required: [\"authenticated\", \"token\", \"issuedAt\", \"expiresAt\"],\n        properties: {\n            authenticated: { type: \"boolean\" },\n            token: { type: \"string\" },\n            issuedAt: { type: \"number\" },\n            expiresAt: { type: \"number\" }\n        },\n        additionalProperties: false\n    };\n    pm.response.to.have.jsonSchema(schema);\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"{{email}}\",\n\"password\": \"{{candidatePassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseURL}}/login",
          "host": [
            "{{baseURL}}"
          ],
          "path": [
            "login"
          ]
        }
      },
      "response": []
